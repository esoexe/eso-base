# ESO Kernel: changes on top of Debian's proven trixie-backports 7.2 config (full hardware support)
CONFIG_LOCALVERSION="-eso"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BUILD_SALT="eso-kernel"
# --- responsiveness / gaming ---
CONFIG_SCHED_BORE=y
# CONFIG_HZ_250 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NTSYNC=m
CONFIG_TCP_CONG_BBR=m
# --- build in this environment: no debug info (smaller, faster to build). BTF/sched_ext need it, BORE does not ---
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# --- module signing with our own auto-generated key (Debian's signing keys are not ours) ---
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_COMPRESS_XZ=y
CONFIG_MODULE_COMPRESS_ALL=y
# --- data-centre-only hardware nobody runs ESO OS on (smaller download, faster build) ---
# CONFIG_INFINIBAND is not set
# CONFIG_ISDN is not set
# CONFIG_HAMRADIO is not set
# CONFIG_ATM is not set
# CONFIG_FDDI is not set
# CONFIG_ARCNET is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_CHELSIO is not set
# CONFIG_NET_VENDOR_QLOGIC is not set
# CONFIG_NET_VENDOR_SOLARFLARE is not set
# CONFIG_NET_VENDOR_HUAWEI is not set
# CONFIG_NET_VENDOR_EMULEX is not set
# CONFIG_NET_VENDOR_NETRONOME is not set
# CONFIG_NET_VENDOR_PENSANDO is not set
# CONFIG_NET_VENDOR_FUNGIBLE is not set
# CONFIG_MICROSOFT_MANA is not set
# CONFIG_ICE is not set
# CONFIG_IDPF is not set
# CONFIG_BNXT is not set
# CONFIG_BNX2X is not set
# CONFIG_SCSI_LPFC is not set
# CONFIG_SCSI_QLA_FC is not set
# CONFIG_SCSI_QLA_ISCSI is not set
# CONFIG_SCSI_BFA_FC is not set
# CONFIG_SCSI_QEDI is not set
# CONFIG_SCSI_QEDF is not set
# CONFIG_BE2ISCSI is not set
# CONFIG_SCSI_CHELSIO_FCOE is not set
# CONFIG_SCSI_CXGB4_ISCSI is not set
# CONFIG_NVME_FC is not set
# CONFIG_NVME_TARGET_FC is not set

+/*
+ * ESO OS: asynchronous kernel dirty updates.
+ *
+ * Since Linux 6.19 the virtual GPUs (QEMU bochs/stdvga, virtio-gpu, QXL, Cirrus, Hyper-V, VKMS, ...) simulate vblank
+ * interrupts with a timer, and drm_atomic_helper_dirtyfb() commits synchronously: every DRM_IOCTL_MODE_DIRTYFB now
+ * sleeps until the next (simulated) vblank. modesetting calls it from the BlockHandler after every screen update, so
+ * the whole X server - input, every client, the window manager - stood still for most of each frame; with mouse
+ * input arriving faster than the refresh rate it never caught up: a dragged window froze until the button was
+ * released, then jumped. Here the main thread only queues the damaged rectangles and returns at once; a helper
+ * thread hands them to the kernel (merging what arrives while it waits for the vblank). The screen still updates at
+ * the display rate, and X never waits for it. ESO_SYNC_DIRTY=1 in the server's environment restores the old path.
+ * Where the kernel does not pace DIRTYFB at all (vmwgfx; ESO's virtio-gpu without the simulated vblank) the helper
+ * sends at most ESO_DIRTY_MAX_HZ (default 250) updates a second: every host refresh up to 240 Hz still gets a fresh
+ * picture, and a 1000 Hz mouse does not make the host copy the moving window 1000 times a second.
+ *
+ * No torn pictures: the host reads the framebuffer when it processes a send, after DIRTYFB has returned to the
+ * helper. On virtio-gpu (ESO's module fences dumb buffers: DIRTYFB returns once the host has read them) and vmwgfx the
+ * shadow copy into the framebuffer therefore waits while a send is in flight (a fraction of a millisecond, at most
+ * 20 ms) and the helper never starts a send while that copy runs: the host never shows a band of the window from one
+ * picture and the rest from the next. Drivers that pace DIRTYFB to a vblank skip the wait (it would bring the stall
+ * back). ESO_DIRTY_NO_WAIT=1 turns it off.
+ */
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <time.h>
+
+#define ESO_DIRTY_SLOTS 4
+#define ESO_DIRTY_CLIPS 128
+
+struct eso_dirty_slot {
+    uint32_t fb_id;
+    unsigned n;
+    drmModeClip clips[ESO_DIRTY_CLIPS];
+};
+
+static struct {
+    pthread_mutex_t lock;
+    pthread_cond_t cond;
+    int state;                       /* 0 = not started, 1 = running, -1 = unavailable (synchronous) */
+    int fd;
+    int wait_ok;                     /* the shadow copy waits for sends in flight (virtio-gpu, vmwgfx) */
+    int inflight;                    /* the helper is inside DIRTYFB */
+    int writing;                     /* the main thread is copying into the framebuffer */
+    pthread_cond_t idle;
+    struct eso_dirty_slot slot[ESO_DIRTY_SLOTS];
+} eso_dirty = { .lock = PTHREAD_MUTEX_INITIALIZER, .cond = PTHREAD_COND_INITIALIZER, .state = 0, .fd = -1,
+                .idle = PTHREAD_COND_INITIALIZER };
+
+static void
+eso_dirty_send(int fd, uint32_t fb_id, drmModeClip *clip, unsigned n)
+{
+    unsigned i;
+
+    if (drmModeDirtyFB(fd, fb_id, clip, n) == -EINVAL) {
+        for (i = 0; i < n; i++)      /* too much at once for the driver: one at a time */
+            if (drmModeDirtyFB(fd, fb_id, &clip[i], 1) < 0)
+                break;
+    }
+}
+
+static void *
+eso_dirty_thread(void *arg)
+{
+    static struct eso_dirty_slot work[ESO_DIRTY_SLOTS];
+    int i, fd, have;
+
+    struct timespec last = { 0, 0 }, now;
+    long min_ns = 4000000;           /* 250 Hz */
+    const char *hz = getenv("ESO_DIRTY_MAX_HZ");
+
+    (void) arg;
+    if (hz && atoi(hz) > 0)
+        min_ns = 1000000000L / atoi(hz);
+    pthread_mutex_lock(&eso_dirty.lock);
+    for (;;) {
+        have = 0;
+        for (i = 0; i < ESO_DIRTY_SLOTS; i++)
+            have |= eso_dirty.slot[i].n != 0;
+        if (!have || eso_dirty.writing) {
+            pthread_cond_wait(&eso_dirty.cond, &eso_dirty.lock);
+            continue;
+        }
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        {
+            long el = (now.tv_sec - last.tv_sec) * 1000000000L + (now.tv_nsec - last.tv_nsec);
+
+            if (el >= 0 && el < min_ns) {
+                /* too soon after the last send: wait out the rest, merging whatever arrives meanwhile */
+                struct timespec d = { 0, min_ns - el };
+
+                pthread_mutex_unlock(&eso_dirty.lock);
+                nanosleep(&d, NULL);
+                pthread_mutex_lock(&eso_dirty.lock);
+                continue;
+            }
+        }
+        last = now;
+        eso_dirty.inflight = 1;
+        fd = eso_dirty.fd;
+        for (i = 0; i < ESO_DIRTY_SLOTS; i++) {
+            work[i] = eso_dirty.slot[i];
+            eso_dirty.slot[i].n = 0;
+        }
+        pthread_mutex_unlock(&eso_dirty.lock);
+        for (i = 0; i < ESO_DIRTY_SLOTS; i++)
+            if (work[i].n)
+                eso_dirty_send(fd, work[i].fb_id, work[i].clips, work[i].n);
+        pthread_mutex_lock(&eso_dirty.lock);
+        eso_dirty.inflight = 0;
+        pthread_cond_broadcast(&eso_dirty.idle);
+    }
+    return NULL;
+}
+
+/* queue the clips for fb_id; FALSE = could not queue, the caller sends them itself */
+static Bool
+eso_dirty_queue(int fd, uint32_t fb_id, const drmModeClip *clip, unsigned n)
+{
+    struct eso_dirty_slot *s = NULL;
+    unsigned i;
+
+    pthread_mutex_lock(&eso_dirty.lock);
+    if (eso_dirty.state == 0) {
+        const char *e = getenv("ESO_SYNC_DIRTY");
+        pthread_t th;
+        sigset_t all, old;
+
+        eso_dirty.state = -1;
+        {
+            drmVersionPtr v = drmGetVersion(fd);
+            const char *nw = getenv("ESO_DIRTY_NO_WAIT");
+
+            eso_dirty.wait_ok = v && v->name && (!strcmp(v->name, "virtio_gpu") || !strcmp(v->name, "vmwgfx")) &&
+                                !(nw && *nw && *nw != '0');
+            if (v)
+                drmFreeVersion(v);
+        }
+        if (!(e && *e && *e != '0')) {
+            sigfillset(&all);        /* the helper never takes the server's signals */
+            pthread_sigmask(SIG_BLOCK, &all, &old);
+            if (pthread_create(&th, NULL, eso_dirty_thread, NULL) == 0) {
+                pthread_detach(th);
+                eso_dirty.state = 1;
+            }
+            pthread_sigmask(SIG_SETMASK, &old, NULL);
+        }
+    }
+    if (eso_dirty.state != 1) {
+        pthread_mutex_unlock(&eso_dirty.lock);
+        return FALSE;
+    }
+    eso_dirty.fd = fd;
+    for (i = 0; i < ESO_DIRTY_SLOTS && !s; i++)
+        if (eso_dirty.slot[i].n && eso_dirty.slot[i].fb_id == fb_id)
+            s = &eso_dirty.slot[i];
+    for (i = 0; i < ESO_DIRTY_SLOTS && !s; i++)
+        if (!eso_dirty.slot[i].n)
+            s = &eso_dirty.slot[i];
+    if (!s) {
+        pthread_mutex_unlock(&eso_dirty.lock);
+        return FALSE;
+    }
+    s->fb_id = fb_id;
+    if (s->n + n <= ESO_DIRTY_CLIPS) {
+        memcpy(&s->clips[s->n], clip, n * sizeof(*clip));
+        s->n += n;
+    } else {                         /* more than fits: one rectangle around everything */
+        drmModeClip b = s->n ? s->clips[0] : clip[0];
+
+        for (i = 0; i < s->n; i++) {
+            b.x1 = min(b.x1, s->clips[i].x1); b.y1 = min(b.y1, s->clips[i].y1);
+            b.x2 = max(b.x2, s->clips[i].x2); b.y2 = max(b.y2, s->clips[i].y2);
+        }
+        for (i = 0; i < n; i++) {
+            b.x1 = min(b.x1, clip[i].x1); b.y1 = min(b.y1, clip[i].y1);
+            b.x2 = max(b.x2, clip[i].x2); b.y2 = max(b.y2, clip[i].y2);
+        }
+        s->clips[0] = b;
+        s->n = 1;
+    }
+    pthread_cond_signal(&eso_dirty.cond);
+    pthread_mutex_unlock(&eso_dirty.lock);
+    return TRUE;
+}
+
+/* the main thread is about to copy into the framebuffer: let a send in flight finish, hold the next one back */
+static void
+eso_dirty_begin_write(void)
+{
+    struct timespec dl;
+
+    if (eso_dirty.state != 1 || !eso_dirty.wait_ok)
+        return;
+    pthread_mutex_lock(&eso_dirty.lock);
+    clock_gettime(CLOCK_REALTIME, &dl);
+    dl.tv_nsec += 20000000;
+    if (dl.tv_nsec >= 1000000000L) {
+        dl.tv_sec++;
+        dl.tv_nsec -= 1000000000L;
+    }
+    while (eso_dirty.inflight)
+        if (pthread_cond_timedwait(&eso_dirty.idle, &eso_dirty.lock, &dl) == ETIMEDOUT)
+            break;
+    eso_dirty.writing = 1;
+    pthread_mutex_unlock(&eso_dirty.lock);
+}
+
+static void
+eso_dirty_end_write(void)
+{
+    if (!eso_dirty.writing)
+        return;
+    pthread_mutex_lock(&eso_dirty.lock);
+    eso_dirty.writing = 0;
+    pthread_cond_signal(&eso_dirty.cond);
+    pthread_mutex_unlock(&eso_dirty.lock);
+}
+

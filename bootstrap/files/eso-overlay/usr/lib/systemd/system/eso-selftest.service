[Unit]
Description=ESO self-test report on the serial console (only with eso.selftest on the kernel command line)
ConditionKernelCommandLine=eso.selftest
# not After=graphical.target: one stuck boot job would keep the report from ever appearing (the script waits itself)
After=greetd.service

[Service]
Type=simple
ExecStart=/usr/libexec/eso-selftest
StandardOutput=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=ESO compressed RAM swap (zram)
DefaultDependencies=no
After=systemd-modules-load.service
Before=swap.target
ConditionVirtualization=!container

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/eso-zram start
ExecStop=/usr/libexec/eso-zram stop

[Install]
WantedBy=swap.target

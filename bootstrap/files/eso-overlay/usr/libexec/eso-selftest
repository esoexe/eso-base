#!/bin/bash
# ESO self-test (CI boot test): after the desktop has settled, report memory and what runs, on the serial console.
sleep "${ESO_SELFTEST_WAIT:-100}"
# the serial login (agetty) hangs up ttyS0 at start, which kills descriptors opened earlier: build the report in a
# file, then open the ports only now. ttyS1 is a second port that nothing else uses (the CI test gives QEMU two).
# run a command as USER (plain, no session environment)
asuser_plain() { local u=$1; shift; python3 -c 'import os,pwd,sys
p=pwd.getpwnam(sys.argv[1]); os.initgroups(p.pw_name,p.pw_gid); os.setgid(p.pw_gid); os.setuid(p.pw_uid)
os.environ.update(HOME=p.pw_dir,USER=p.pw_name,LOGNAME=p.pw_name); os.execvp(sys.argv[2],sys.argv[2:])' "$u" "$@"; }
report() {
pss() { awk '/^Pss:/{s+=$2} END{print s+0}' "/proc/$1/smaps_rollup" 2>/dev/null; }
echo "ESO-SELFTEST begin $(date -u +%T) uptime=$(cut -d' ' -f1 /proc/uptime)s"
. /etc/os-release; echo "ESO-SELFTEST os: $PRETTY_NAME | kernel $(uname -r)"
free -m | awk '/^Mem:/{print "ESO-SELFTEST mem: used " $3 " MiB of " $2 " MiB (available " $7 " MiB)"}'
total=0; rows=()
for p in /proc/[0-9]*; do
    n=${p#/proc/}; c=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null | cut -c1-70); [[ -n $c ]] || continue
    k=$(pss "$n"); [[ -n $k && $k -gt 0 ]] || continue
    total=$((total + k)); rows+=("$k $(stat -c %U "$p") $c")
done
echo "ESO-SELFTEST pss-total: $((total / 1024)) MiB (all processes)"
printf '%s\n' "${rows[@]}" | sort -rn | head -15 | awk '{printf "ESO-SELFTEST   %6.1f MiB  %-8s %s\n", $1/1024, $2, substr($0, index($0,$3))}'
for x in Xorg xfwm4 eso-shell eso-lite-session; do
    pgrep -f "$x" >/dev/null && echo "ESO-SELFTEST running: $x" || echo "ESO-SELFTEST NOT running: $x"
done
echo "ESO-SELFTEST session: eso-session@eso=$(systemctl is-active eso-session@eso.service 2>/dev/null) greetd=$(systemctl is-active greetd.service 2>/dev/null) vt=$(cat /sys/class/tty/tty0/active 2>/dev/null)"
# boot speed: firmware/loader (when known) + kernel + initramfs + system, and when the desktop (eso-shell) started
echo "ESO-SELFTEST boot-time: $(systemd-analyze time 2>/dev/null | head -n1 | sed 's/^Startup finished in //')"
sp=$(pgrep -f "bin/eso-shell( |$)" | head -n1)
[[ -n $sp ]] && echo "ESO-SELFTEST desktop-at: $(awk -v up="$(cut -d' ' -f1 /proc/uptime)" -v et="$(ps -o etimes= -p "$sp" | tr -d ' ')" 'BEGIN{printf "%.1f", up-et}') s after the kernel started"
systemd-analyze blame 2>/dev/null | head -n 8 | sed 's/^ */ESO-SELFTEST slowest: /'
echo "ESO-SELFTEST setuid: $(find /usr -xdev -perm -4000 -type f 2>/dev/null | sed 's|.*/||' | sort | tr '\n' ' ')"
# ESO Lock: the real PAM check as the live user (no password: Enter unlocks)
# boot timeline around the hand-over from the boot animation to the desktop (seconds since boot)
eu=$(id -u eso 2>/dev/null)
xl=$(ls -t /home/eso/.local/share/xorg/Xorg.*.log /var/log/Xorg.0.log 2>/dev/null | head -n1)
if [[ -n $xl ]]; then
    grep -m1 -E '^\[ *[0-9.]+\]' "$xl" | sed 's/^\[ *\([0-9.]*\)\].*/ESO-SELFTEST timeline: \1 Xorg log starts/'
    # only the slow steps: every line that comes 15 ms or more after the previous one (with that previous line),
    # plus the input devices (each keyboard-like device costs one keymap compile)
    awk 'match($0, /^\[ *[0-9.]+\]/) { t = substr($0, 2, RLENGTH - 2) + 0
             if (t - pt >= 0.015) { printf "ESO-SELFTEST xorg-slow: +%dms before %.3f %s  (after: %s)\n", (t - pt) * 1000, t, substr($0, RLENGTH + 1, 90), substr(pl, 1, 70) }
             else if ($0 ~ /Adding input device|XINPUT: Adding/) printf "ESO-SELFTEST xorg-input: %.3f %s\n", t, substr($0, RLENGTH + 1, 90)
             pt = t; pl = substr($0, RLENGTH + 1) }' "$xl" | head -n 50
fi
hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
for pn in eso-session-run eso-auto-session startx xinit Xorg eso-lite-session xfwm4 eso-shell; do
    pid=$(pgrep -o -x "$pn" 2>/dev/null || pgrep -o -f "/$pn( |$)" 2>/dev/null | head -n1)
    [[ -n $pid && -r /proc/$pid/stat ]] && awk -v hz="$hz" -v n="$pn" '{ sub(/^.*\) /, ""); printf "ESO-SELFTEST timeline: %.2f %s started\n", $20 / hz, n }' "/proc/$pid/stat"
done
[[ -n $eu && -r /run/user/$eu/eso-rootpaint.t ]] && echo "ESO-SELFTEST timeline: $(cat /run/user/$eu/eso-rootpaint.t) wallpaper painted"
journalctl -b -o short-monotonic --no-pager 2>/dev/null | grep -E 'eso-session@eso|plymouth-quit|Starting .*session|Reached target graphical' | head -n 6 | sed 's/^/ESO-SELFTEST timeline-j: /'
[[ -x /usr/libexec/eso-pamtest ]] && echo "ESO-SELFTEST lock-pam: $(cd /tmp && asuser_plain eso python3 /usr/libexec/eso-pamtest eso-lock '' 2>&1 | tail -n1)"
# ESO updates on ESO Base: a real signed check against the live ESO update server (installs nothing)
if [[ -x /usr/local/libexec/eso-update ]]; then
    u=$(timeout 120 /usr/local/libexec/eso-update check 2>&1 | tail -1)
    echo "ESO-SELFTEST update-check: ${u:0:300}"
    echo "ESO-SELFTEST eso-packages: $(cd /var/lib/eso/pkgs 2>/dev/null && for f in *.control; do printf '%s=%s ' "${f%.control}" "$(sed -n 's/^Version: //p' "$f")"; done)"
fi
# security + boot animation
echo "ESO-SELFTEST root-account: $(passwd -S root 2>/dev/null | awk '{print $2}') (L = locked)"
echo "ESO-SELFTEST splash: cmdline=$(grep -qw splash /proc/cmdline && echo splash || echo none) plymouth=$(plymouth --ping 2>/dev/null && echo still-running || echo ended)"
dmesg 2>/dev/null | grep "eso-init:" | sed "s/^/ESO-SELFTEST initramfs: /"
il=$(ls /run/user/*/eso/intro.log 2>/dev/null | head -n1)
if [[ -z $il ]]; then echo "ESO-SELFTEST intro: not started"
elif grep -q Traceback "$il"; then echo "ESO-SELFTEST intro: FAILED: $(tail -n1 "$il")"
else echo "ESO-SELFTEST intro: played"; fi
# stage 6d tools that ESO's apps call
miss=""; for c in which 7z xdg-open xdg-settings xdg-user-dir update-desktop-database brightnessctl playerctl maim slop rg \
    ssh git bluetoothctl powerprofilesctl tesseract iptables ufw clamscan flatpak fusermount3 pw-play pw-record; do
    command -v "$c" >/dev/null 2>&1 || miss="$miss $c"; done
echo "ESO-SELFTEST tools-missing:${miss:- none}"
echo "ESO-SELFTEST flatpak: $(flatpak --version 2>/dev/null) remotes: $(ls /etc/flatpak/remotes.d 2>/dev/null | tr '\n' ' ')"
echo "ESO-SELFTEST mpv-vulkan: libplacebo+glslang=$(ldd /usr/lib/libplacebo.so 2>/dev/null | grep -c glslang) vo: $(mpv --vo=help 2>/dev/null | grep -oE '^ +(gpu-next|gpu) ' | tr -d ' ' | tr '\n' ' ')"
echo "ESO-SELFTEST ocr: $(cd / && tesseract --list-langs 2>/dev/null | tail -n +2 | tr '\n' ' ')"
[[ -x /usr/libexec/eso-ocrtest ]] && (cd /tmp && asuser_plain eso python3 /usr/libexec/eso-ocrtest 2>&1 | sed 's/^/ESO-SELFTEST ocr-test: /')
# app launch speed: each app started like the Start menu does, timed until its window is on screen, then closed
export DISPLAY=:0 XAUTHORITY=/home/eso/.Xauthority
asuser() { python3 -c 'import os,pwd,sys
p=pwd.getpwnam("eso"); os.initgroups(p.pw_name,p.pw_gid); os.setgid(p.pw_gid); os.setuid(p.pw_uid)
os.environ.update(HOME=p.pw_dir,USER=p.pw_name,LOGNAME=p.pw_name,XDG_RUNTIME_DIR="/run/user/%d" % p.pw_uid,
  DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/%d/bus" % p.pw_uid,
  PATH=p.pw_dir+"/.local/bin:/usr/local/bin:/usr/bin:/usr/sbin")
os.execvp(sys.argv[1],sys.argv[1:])' "$@"; }
wins() { wmctrl -l 2>/dev/null | awk '{print $1}' | sort; }
if [[ -S /tmp/.X11-unix/X0 ]] && command -v wmctrl >/dev/null; then
    for app in eso-files eso-settings eso-notepad eso-taskmgr eso-calc eso-browser; do
        before=$(wins); t0=$(date +%s%N); asuser "$app" >/dev/null 2>&1 & id=""
        for i in $(seq 1 200); do
            sleep 0.05; id=$(comm -13 <(echo "$before") <(wins) | head -1); [[ -n $id ]] && break
        done
        t1=$(date +%s%N)
        if [[ -n $id ]]; then echo "ESO-SELFTEST app-launch: $app window after $(( (t1 - t0) / 1000000 )) ms"
            sleep 2; wmctrl -ic "$id" 2>/dev/null; sleep 1
        else echo "ESO-SELFTEST app-launch: $app NO window within 10 s"; fi
    done
    free -m | awk '/^Mem:/{print "ESO-SELFTEST mem-after-apps: used " $3 " MiB (available " $7 " MiB)"}'
fi
echo "ESO-SELFTEST system-state: $(systemctl is-system-running 2>/dev/null)"
systemctl list-jobs --no-legend --plain 2>/dev/null | head -10 | sed 's/^/ESO-SELFTEST waiting-job: /'
systemctl --failed --no-legend --plain 2>/dev/null | sed 's/^/ESO-SELFTEST failed-unit: /'
echo "ESO-SELFTEST end"
}
report > /run/eso-selftest.txt 2>&1
for t in /dev/ttyS1 /dev/ttyS0; do cat /run/eso-selftest.txt > "$t" 2>/dev/null || true; done
cat /run/eso-selftest.txt

#!/bin/bash
# eso-mkinitramfs KERNEL-VERSION [OUT]: ESO Base's own small initramfs (bash + kmod + udev + util-linux).
# Loads the storage/filesystem drivers, finds root= (UUID=, LABEL=, PARTUUID= or /dev/…) and switches to it.
set -euo pipefail
KV=${1:?kernel version}
OUT=${2:-/boot/initrd.img-$KV}
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
mkdir -p "$W"/{dev,proc,sys,run,newroot,etc,usr/{bin,sbin,lib/{modules,udev/rules.d,systemd}}} "$W/lib64"
for d in bin sbin lib; do ln -s usr/$d "$W/$d"; done
mknod -m 600 "$W/dev/console" c 5 1 2>/dev/null || true; mknod -m 666 "$W/dev/null" c 1 3 2>/dev/null || true
copy_bin() {
    local f=$1 l
    [[ -e $W$f ]] || install -D "$f" "$W$f"
    for l in $(ldd "$f" 2>/dev/null | grep -o '/[^ ]*' | sort -u); do
        [[ -e $W$l ]] || install -D "$l" "$W$l"
        [[ -e $W$(readlink -f "$l") ]] || install -D "$(readlink -f "$l")" "$W$(readlink -f "$l")"
    done
}
for b in bash sh mount umount mkdir ls cat sed sleep switch_root blkid findfs kmod modprobe insmod udevadm fsck.ext4 e2fsck mountpoint; do
    p=$(command -v $b || true); [[ -n $p ]] && copy_bin "$(readlink -f "$p")" && { [[ $(readlink -f "$p") == "$p" ]] || cp -a "$p" "$W$p"; } || true
done
ln -sf kmod "$W/usr/bin/modprobe" 2>/dev/null || true
cp -a /usr/lib/systemd/systemd-udevd "$W/usr/lib/systemd/" && copy_bin /usr/lib/systemd/systemd-udevd
cp -a /usr/lib/udev/rules.d/{50-udev-default,60-persistent-storage,80-drivers}.rules "$W/usr/lib/udev/rules.d/" 2>/dev/null || true
for h in ata_id scsi_id; do [[ -e /usr/lib/udev/$h ]] && copy_bin /usr/lib/udev/$h && cp -a /usr/lib/udev/$h "$W/usr/lib/udev/" || true; done
M=/usr/lib/modules/$KV
mkdir -p "$W$M"
cp "$M"/modules.{order,builtin,builtin.modinfo} "$W$M/" 2>/dev/null || true
# storage, filesystems, USB, CD/ISO and virtual disks: enough to reach the root (or the live medium) on any PC or VM.
# Each module's dependencies are resolved with modprobe -D, wherever they live in the tree.
( cd "$M" && find kernel/drivers/{ata,nvme,scsi,block,md,virtio,mmc,cdrom,usb/host,usb/storage,usb/core,usb/common,hid} \
      kernel/drivers/{input/keyboard,hv,message/fusion,firmware/efi} \
      kernel/fs/{ext4,jbd2,btrfs,xfs,fat,vfat,nls,isofs,overlayfs,squashfs} -name '*.ko*' 2>/dev/null || true ) |
while read -r m; do
    n=${m##*/}; n=${n%%.ko*}
    modprobe -S "$KV" -D "$n" 2>/dev/null | sed -n 's/^insmod //p' | while read -r f; do
        f=${f%% *}; [[ -e $W$f ]] || install -D -m644 "$f" "$W$f"
    done || true
done
# VM display drivers (DRM) so the boot animation draws from the first second in QEMU/KVM, VirtualBox, VMware, Hyper-V.
# Real GPUs (Intel/AMD/NVIDIA) need firmware and load later from the real root; until then plymouth draws on the
# firmware framebuffer (efifb / vesafb), then moves to the GPU when it appears.
for n in bochs virtio-gpu qxl vmwgfx vboxvideo cirrus-qemu hyperv_drm; do
    modprobe -S "$KV" -D "$n" 2>/dev/null | sed -n 's/^insmod //p' | while read -r f; do
        f=${f%% *}; [[ -e $W$f ]] || install -D -m644 "$f" "$W$f"
    done || true
done
# --- boot splash: plymouth with the ESO theme (images only: no fonts needed) ---
SPLASH=0
if [[ -x /usr/sbin/plymouthd && -x /usr/bin/plymouth && -f /usr/share/plymouth/themes/eso/eso.plymouth ]]; then
    copy_bin /usr/sbin/plymouthd; copy_bin /usr/bin/plymouth
    for so in script text details renderers/drm renderers/frame-buffer; do
        [[ -e /usr/lib/plymouth/$so.so ]] && copy_bin "/usr/lib/plymouth/$so.so"
    done
    for th in eso text details; do
        [[ -d /usr/share/plymouth/themes/$th ]] && { mkdir -p "$W/usr/share/plymouth/themes"; cp -a "/usr/share/plymouth/themes/$th" "$W/usr/share/plymouth/themes/"; }
    done
    install -D -m644 /usr/share/plymouth/plymouthd.defaults "$W/usr/share/plymouth/plymouthd.defaults"
    mkdir -p "$W/etc/plymouth"
    printf '[Daemon]\nTheme=eso\nShowDelay=0\nDeviceTimeout=8\n' > "$W/etc/plymouth/plymouthd.conf"
    [[ -f /etc/os-release ]] && cp /etc/os-release "$W/etc/os-release"
    cp -a /usr/lib/udev/rules.d/{70-uaccess,71-seat,73-seat-late}.rules "$W/usr/lib/udev/rules.d/" 2>/dev/null || true
    SPLASH=1
fi
depmod -b "$W" "$KV"
cat > "$W/init" <<'INIT'
#!/bin/bash
PATH=/usr/bin:/usr/sbin
mount -t proc proc /proc; mount -t sysfs sysfs /sys; mount -t devtmpfs devtmpfs /dev; mount -t tmpfs tmpfs /run
root= ro=ro init=/usr/lib/systemd/systemd live=0 label=ESO_CORE splash=0
for a in $(cat /proc/cmdline); do
    case $a in root=*) root=${a#root=};; rw) ro=rw;; init=*) init=${a#init=};; eso.live) live=1;; eso.label=*) label=${a#eso.label=};; splash) splash=1;; nosplash|nomodeset) splash=0; nospl=1;; esac
done
/usr/lib/systemd/systemd-udevd --daemon --resolve-names=never
[[ ${nospl:-0} == 1 ]] && splash=0
# the ESO boot animation from the first second (plymouth follows the display as udev brings it up below)
if [[ $splash == 1 && -x /usr/sbin/plymouthd ]]; then
    mkdir -p /run/plymouth /dev/pts; mountpoint -q /dev/pts || mount -t devpts devpts -o gid=5,mode=620 /dev/pts
    plymouthd --mode=boot --attach-to-session --ignore-serial-consoles --pid-file=/run/plymouth/pid && plymouth show-splash || splash=0
fi
udevadm trigger --action=add --type=subsystems
# the display first: its driver loads before the disks', so the ESO animation (not a text fallback) is the first
# thing on screen. plymouth waits up to DeviceTimeout for a graphical display before falling back to text.
udevadm trigger --action=add --subsystem-match=pci --attr-match=class=0x03*; udevadm settle --timeout=5
udevadm trigger --action=add --type=devices; udevadm settle --timeout=30
# safety net: the usual disk controllers even if a modalias event was missed (cheap, no-ops when absent)
for m in virtio_pci virtio_blk virtio_scsi ahci ata_piix nvme sd_mod sr_mod mmc_block sdhci_pci xhci_pci ehci_pci \
         usb_storage uas hv_storvsc vmw_pvscsi mptspi ext4 btrfs xfs vfat; do modprobe -q $m 2>/dev/null; done
udevadm settle --timeout=10
if [[ $live == 1 ]]; then
    # ESO live medium (ISO9660 label ESO_CORE, or eso.label=...): squashfs read-only + RAM overlay, nothing written to the disk
    for m in isofs squashfs overlay loop sr_mod cdrom usb_storage uas; do modprobe -q $m; done
    med=
    for ((i = 0; i < 100; i++)); do med=$(findfs LABEL=$label 2>/dev/null) && break; sleep 0.2; done
    [[ -n $med ]] || { echo "ESO: live medium (label $label) not found"; plymouth quit 2>/dev/null; exec bash; }
    mkdir -p /run/eso/{medium,sq,ov}
    mount -o ro "$med" /run/eso/medium || { echo "ESO: cannot mount $med"; plymouth quit 2>/dev/null; exec bash; }
    sq=$(ls /run/eso/medium/live/*.squashfs 2>/dev/null | sed -n 1p)
    mount -t squashfs -o loop,ro "$sq" /run/eso/sq || { echo "ESO: cannot mount $sq"; plymouth quit 2>/dev/null; exec bash; }
    mount -t tmpfs -o mode=755,size=75% tmpfs /run/eso/ov; mkdir -p /run/eso/ov/{upper,work}
    mount -t overlay overlay -o lowerdir=/run/eso/sq,upperdir=/run/eso/ov/upper,workdir=/run/eso/ov/work /newroot ||
        { echo "ESO: overlay failed"; plymouth quit 2>/dev/null; exec bash; }
    root=live
fi
dev=
[[ $live == 1 ]] && dev=overlay
for ((i = 0; i < 50 && live == 0; i++)); do
    case $root in UUID=*|LABEL=*|PARTUUID=*) dev=$(findfs "$root" 2>/dev/null);; *) [[ -b $root ]] && dev=$root;; esac
    [[ -n $dev ]] && break; sleep 0.2
done
if [[ -z $dev ]]; then
    echo "ESO: root device $root not found"; echo "partitions:"; cat /proc/partitions
    echo "modules loaded: $(wc -l < /proc/modules)"; blkid 2>&1 | head -10
    plymouth quit 2>/dev/null; exec bash
fi
[[ $live == 1 ]] || mount -o $ro "$dev" /newroot || { echo "ESO: cannot mount $dev"; plymouth quit 2>/dev/null; exec bash; }
[[ $splash == 1 ]] && plymouth update-root-fs --new-root-dir=/newroot 2>/dev/null
udevadm control --exit
mount --move /run /newroot/run 2>/dev/null; mount --move /dev /newroot/dev 2>/dev/null
umount /sys /proc
exec switch_root /newroot "$init"
INIT
chmod 755 "$W/init"
( cd "$W" && find . -print0 | cpio --null -o -H newc --quiet ) | zstd -q -19 -T0 > "$OUT"
echo "$OUT: $(du -h "$OUT" | cut -f1)"

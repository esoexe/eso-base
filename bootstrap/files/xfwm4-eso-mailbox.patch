+void
+compositorEsoGlueBegin (ScreenInfo *screen_info, int x_root, int y_root)
+{
+#ifdef HAVE_COMPOSITOR
+    if (eso_glue_on || !eso_glue_enabled () || !screen_info->compositor_active || screen_info->zoomed)
+    {
+        return;
+    }
+    update_cursor (screen_info);                       /* the image shown now (the move grab cursor) + hotspot */
+    if (!screen_info->cursorPicture)
+    {
+        return;
+    }
+    eso_glue_on = TRUE;
+    eso_glue_x = x_root;
+    eso_glue_y = y_root;
+    screen_info->cursorLocation.x = x_root - screen_info->cursorOffsetX;
+    screen_info->cursorLocation.y = y_root - screen_info->cursorOffsetY;
+    XFixesHideCursor (screen_info->display_info->dpy, screen_info->xroot);
+    expose_area (screen_info, &screen_info->cursorLocation, 1);
+#endif /* HAVE_COMPOSITOR */
+}
+
+void
+compositorEsoGlueMove (ScreenInfo *screen_info, int x_root, int y_root)
+{
+#ifdef HAVE_COMPOSITOR
+    if (!eso_glue_on || (x_root == eso_glue_x && y_root == eso_glue_y))
+    {
+        return;
+    }
+    expose_area (screen_info, &screen_info->cursorLocation, 1);
+    eso_glue_x = x_root;
+    eso_glue_y = y_root;
+    screen_info->cursorLocation.x = x_root - screen_info->cursorOffsetX;
+    screen_info->cursorLocation.y = y_root - screen_info->cursorOffsetY;
+    expose_area (screen_info, &screen_info->cursorLocation, 1);
+#endif /* HAVE_COMPOSITOR */
+}
+
+void
+compositorEsoGlueEnd (ScreenInfo *screen_info)
+{
+#ifdef HAVE_COMPOSITOR
+    if (!eso_glue_on)
+    {
+        return;
+    }
+    eso_glue_on = FALSE;
+    XFixesShowCursor (screen_info->display_info->dpy, screen_info->xroot);
+    if (screen_info->compositor_active)
+    {
+        expose_area (screen_info, &screen_info->cursorLocation, 1);
+    }
+#endif /* HAVE_COMPOSITOR */
+}
 

+static gboolean
+eso_mailbox (void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        const gchar *e = g_getenv ("ESO_XFWM_MAILBOX");
+        v = (e && e[0] == '0') ? 0 : 1;
+    }
+    return v;
+}
+
+static gint64
+eso_paint_us (void)
+{
+    static gint64 v = -1;
+    if (v < 0)
+    {
+        const gchar *e = g_getenv ("ESO_XFWM_PAINT_US");
+        v = e ? g_ascii_strtoll (e, NULL, 10) : 6000;
+        if (v < 0 || v > 50000)
+            v = 6000;
+    }
+    return v;
+}

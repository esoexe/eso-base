+/* ESO: pointer prediction for glued drags (the compositor draws the cursor in the window's frames, so window and
+   cursor are moved ahead together by the same amount and stay glued). Velocity comes from the X event times over a
+   ~24 ms window (robust for 125 Hz mice and 1000 Hz gaming mice alike); slow, precise moves get no prediction; when
+   the hand stops, the lead eases back to the exact pointer within ~50 ms; on release the window lands exactly. */
+#define ESO_RING 32
+static struct { Time t; int x, y; } eso_ring[ESO_RING];
+static int eso_ring_n, eso_ring_i;
+static int eso_rx, eso_ry;                 /* last real pointer */
+static double eso_offx, eso_offy;          /* lead applied right now */
+static gint64 eso_last_us;
+static guint eso_settle_id;
+static Client *eso_c;
+static MoveResizeData *eso_pd;
+static gboolean eso_tiled;
+
+static void
+eso_predict_stop (void)
+{
+    if (eso_settle_id)
+    {
+        g_source_remove (eso_settle_id);
+        eso_settle_id = 0;
+    }
+    eso_ring_n = eso_ring_i = 0;
+    eso_offx = eso_offy = 0.0;
+    eso_c = NULL;
+    eso_pd = NULL;
+    eso_tiled = FALSE;
+}
+
+static void
+eso_place (Client *c, MoveResizeData *pd, int qx, int qy)
+{
+    XWindowChanges wc;
+
+    c->x = pd->ox + (qx - pd->mx);
+    c->y = pd->oy + (qy - pd->my);
+    clientConstrainPos (c, FALSE);
+    wc.x = c->x;
+    wc.y = c->y;
+    clientConfigure (c, &wc, CWX | CWY, NO_CFG_FLAG);
+    compositorEsoGlueMove (c->screen_info, qx, qy);
+}
+
+static gboolean
+eso_settle_tick (gpointer data)
+{
+    Client *c = eso_c;
+
+    if (!c || !eso_pd || !FLAG_TEST (c->xfwm_flags, XFWM_FLAG_MOVING_RESIZING) || eso_tiled)
+    {
+        eso_settle_id = 0;
+        return FALSE;
+    }
+    if (g_get_monotonic_time () - eso_last_us < 24000)
+    {
+        return TRUE;                               /* the hand is still moving: motion events steer */
+    }
+    eso_offx *= 0.35;
+    eso_offy *= 0.35;
+    if (fabs (eso_offx) < 1.0 && fabs (eso_offy) < 1.0)
+    {
+        eso_offx = eso_offy = 0.0;
+    }
+    eso_place (c, eso_pd, eso_rx + (int) lrint (eso_offx), eso_ry + (int) lrint (eso_offy));
+    if (eso_offx == 0.0 && eso_offy == 0.0)
+    {
+        eso_settle_id = 0;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* the real pointer (x, y) at X time t -> the position to draw window and cursor at */
+static void
+eso_predict (ScreenInfo *screen_info, int x, int y, Time t, int *qx, int *qy)
+{
+    int lead_ms, k, j;
+    double vx = 0.0, vy = 0.0, sp, dx, dy, m;
+
+    eso_rx = *qx = x;
+    eso_ry = *qy = y;
+    eso_last_us = g_get_monotonic_time ();
+    if (!compositorEsoGlueActive (screen_info) || (lead_ms = compositorEsoPredictMs (screen_info)) <= 0 || eso_tiled)
+    {
+        eso_offx = eso_offy = 0.0;
+        return;
+    }
+    if (eso_ring_n > 0)
+    {
+        j = (eso_ring_i + ESO_RING - 1) % ESO_RING;
+        if ((long) (t - eso_ring[j].t) > 60 || (long) (t - eso_ring[j].t) < 0)
+        {
+            eso_ring_n = 0;                        /* a pause: start fresh */
+        }
+    }
+    eso_ring[eso_ring_i].t = t;
+    eso_ring[eso_ring_i].x = x;
+    eso_ring[eso_ring_i].y = y;
+    eso_ring_i = (eso_ring_i + 1) % ESO_RING;
+    if (eso_ring_n < ESO_RING)
+    {
+        eso_ring_n++;
+    }
+    /* the newest sample at least 24 ms old (or the oldest one if it is at least 8 ms old) */
+    for (k = 1; k < eso_ring_n; k++)
+    {
+        long dt;
+
+        j = (eso_ring_i + ESO_RING - 1 - k) % ESO_RING;
+        dt = (long) (t - eso_ring[j].t);
+        if (dt >= 24 || (k == eso_ring_n - 1 && dt >= 8))
+        {
+            vx = (x - eso_ring[j].x) * 1000.0 / dt;
+            vy = (y - eso_ring[j].y) * 1000.0 / dt;
+            break;
+        }
+    }
+    sp = sqrt (vx * vx + vy * vy);
+    if (sp < 200.0)
+    {
+        eso_offx = eso_offy = 0.0;                 /* slow and precise: exactly under the pointer */
+        return;
+    }
+    dx = vx * lead_ms / 1000.0;
+    dy = vy * lead_ms / 1000.0;
+    if (sp < 500.0)
+    {
+        dx *= (sp - 200.0) / 300.0;                /* fade in */
+        dy *= (sp - 200.0) / 300.0;
+    }
+    m = sqrt (dx * dx + dy * dy);
+    if (m > 48.0)
+    {
+        dx *= 48.0 / m;
+        dy *= 48.0 / m;
+    }
+    eso_offx = dx;
+    eso_offy = dy;
+    *qx = x + (int) lrint (dx);
+    *qy = y + (int) lrint (dy);
+    if (!eso_settle_id && (dx != 0.0 || dy != 0.0))
+    {
+        eso_settle_id = g_timeout_add_full (G_PRIORITY_HIGH, 16, eso_settle_tick, NULL, NULL);
+    }
+}
